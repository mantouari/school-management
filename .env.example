# ==========================================================================
# Exemple de configuration — copiez ce fichier vers .env et adaptez-le.
#   cp .env.example .env
# ==========================================================================

# Django
DJANGO_SETTINGS_MODULE=school_management.settings.dev
SECRET_KEY=changez-moi-cle-secrete-tres-longue-et-aleatoire
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# En production, ajoutez votre domaine Render :
# CSRF_TRUSTED_HOSTS=mon-app.onrender.com

# Base de données (laisser vide en local = SQLite automatique)
# En dev avec Docker Compose :
DATABASE_URL=postgres://school:school@db:5432/school
# En production (Render injecte cette variable automatiquement) :
# DATABASE_URL=

# Fuseau horaire
TIME_ZONE=Africa/Abidjan
